# 3D printers via the atelier print-orchestrator
# Не коммить этот файл в git.
#
# This API talks to printers ONLY through the atelier print-orchestrator HTTP
# API — there are no direct Moonraker/Bambu-MQTT/Creality-WS/camera connections
# here. Printers themselves are configured in apps/atelier
# (apps/print-orchestrator/config/printers.json).

# Base URL of the orchestrator. With both compose projects on the shared
# docker network (compose.yml network "print-farm", created by
# ops/ensure-print-farm-network.sh) use the service DNS name; do not pin a
# LAN IP.
PRINTER_ORCHESTRATOR_URL=http://print-orchestrator:3100
# Bearer token for the orchestrator API. Only needed if atelier sets
# ORCHESTRATOR_API_TOKEN; reads are open by default.
PRINTER_ORCHESTRATOR_API_TOKEN=
# Per-request timeout for orchestrator calls. Failed idempotent reads are
# retried once with a short jittered backoff, so keep this comfortably under
# PRINTER_MONITOR_POLL_INTERVAL_MS / 2.
PRINTER_ORCHESTRATOR_TIMEOUT_MS=5000
# A printer status whose orchestrator-side updatedAt is older than this is
# flagged stale in GET /api/printers/status and excluded from Telegram event
# classification (a frozen upstream poll must not look like a print event).
PRINTER_STATUS_STALE_MS=120000

# Admin gate. Required for the mutating endpoints (backups run/test-restore,
# pricing write, notification dispatch, printer config, ALL filament warehouse
# writes). Fail-closed: if unset, those endpoints return 503 instead of running
# unauthenticated. Sent as `x-admin-token`. The dashboard must be built with the
# same value as VITE_ADMIN_TOKEN (compose build arg).
ADMIN_TOKEN=

# Inter-service token for apps/atelier → apps/fulfillment calls (the automatic
# filament consume POST /api/inventory/filament/consume and the loaded-reel
# bind POST /api/inventory/printer-filament/sync). Sent by atelier as
# `x-service-token`. Scoped to ONLY those two routes — it does NOT open the
# admin-only warehouse mutations (add/adjust/update/load) or any other admin
# endpoint, so a leaked service token cannot edit thresholds or archive stock.
# Fail-closed: with neither this nor ADMIN_TOKEN set, those routes return 503; a
# wrong token returns 401. Generate a random value, e.g. `openssl rand -hex 32`.
# Never commit the real token — set it in apps/api/.env (compose env_file).
ATELIER_FULFILLMENT_TOKEN=

# Staged-rollout compatibility switch. When true, the inter-service routes above
# accept a caller WITHOUT a valid service token (so an older atelier build that
# does not yet send x-service-token keeps working) and log a warning. OFF by
# default — leave it unset/false in production and turn it off once atelier is
# deployed with ATELIER_FULFILLMENT_TOKEN.
ATELIER_FULFILLMENT_AUTH_OPTIONAL=false

# Read-only filament availability feed for the online shop.
# GET /api/inventory/filament/availability returns aggregated material×color
# availability from filament_stock. Guarded by its OWN bearer token (separate
# from ADMIN_TOKEN; it opens no mutating route). Send it as
# `Authorization: Bearer <token>`. Fail-closed: if FILAMENT_AVAILABILITY_TOKEN
# is unset the endpoint returns 503; a missing/wrong token returns 401.
# Generate a random value, e.g. `openssl rand -hex 32`. Do NOT commit the real
# token — set it in apps/api/.env (loaded via compose env_file).
FILAMENT_AVAILABILITY_TOKEN=
# Minimum grams a material×color must hold to be reported available
# (available = stock_g >= this). Separate from the low_stock_g / critical_stock_g
# warehouse warning bands. Default 100.
FILAMENT_AVAILABILITY_MIN_G=100

# Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ORDERS_ID=
TELEGRAM_TOPIC_PRODUCT_REPORTS_ID=
TELEGRAM_TOPIC_PRINTS_ID=
TELEGRAM_TOPIC_CRITICAL_ERRORS_ID=
TELEGRAM_REQUEST_TIMEOUT_MS=5000
NOTIFICATIONS_POLL_INTERVAL_MS=5000
NOTIFICATIONS_BATCH_SIZE=10

# Printer monitor -> Telegram "Сообщения печати" topic (printer errors, pauses, finished prints).
# Requires TELEGRAM_ENABLED=true, TELEGRAM_TOPIC_PRINTS_ID and
# PRINTER_ORCHESTRATOR_URL set. Off by default.
PRINTER_MONITOR_ENABLED=false
PRINTER_MONITOR_POLL_INTERVAL_MS=15000
# Attach a camera snapshot to printer notifications. Snapshots are fetched from
# the orchestrator (…/camera.jpg?ensureLight=1), which switches the chamber
# light on for night captures; there is no direct camera access from this API.
PRINTER_SNAPSHOT_ENABLED=true
PRINTER_SNAPSHOT_TIMEOUT_MS=8000
PRINTER_SNAPSHOT_MAX_BYTES=3000000
