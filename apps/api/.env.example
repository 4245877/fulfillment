# 3D printers backend config
# Не коммить этот файл в git.

# Bambu: serial = printer serial used in device/<serial>/report topics; accessCode = LAN access code from the printer.
# Enable LAN/local access on the printer, otherwise the local MQTT broker can reject monitoring as "Server unavailable".
#
# Optional per-printer "snapshotUrl": camera still-image endpoint used for Telegram photos.
#   - Absolute URL (e.g. "http://192.168.0.141:8080/?action=snapshot") or a path relative to the host ("/webcam/?action=snapshot").
#   - If omitted, conventional defaults are used: moonraker -> http://<host>/webcam/?action=snapshot, creality -> http://<host>:8080/?action=snapshot.
#   - Bambu has no plain HTTP snapshot endpoint; its camera is grabbed over the local TLS stream (port 6000) using the LAN access code. Enable "LAN Mode Liveview" on the printer.

PRINTERS_CONFIG_JSON='[{"id":"ender3-v3-ke","name":"Creality Ender 3 V3 KE","protocol":"creality","host":"192.168.0.141","port":9999,"profile":"fdm-0.4","material":"PLA / PETG / TPU","enabled":true},{"id":"creality-k2","name":"Creality K2","protocol":"moonraker","host":"192.168.0.132","port":4408,"profile":"fdm-0.4","material":"PLA / PETG / ABS / ASA","enabled":true},{"id":"bambu-a1-combo","name":"Bambu Lab A1 Combo","protocol":"bambu","host":"192.168.0.187","port":8883,"profile":"bambu-a1-combo-0.4","material":"PLA / PETG / TPU","serial":"ТУТ_SERIAL","accessCode":"ТУТ_ACCESS_CODE","enabled":true}]'

# Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ORDERS_ID=
TELEGRAM_TOPIC_PRODUCT_REPORTS_ID=
TELEGRAM_TOPIC_PRINTS_ID=
TELEGRAM_TOPIC_CRITICAL_ERRORS_ID=
TELEGRAM_REQUEST_TIMEOUT_MS=5000
NOTIFICATIONS_POLL_INTERVAL_MS=5000
NOTIFICATIONS_BATCH_SIZE=10

# Printer monitor -> Telegram "Повідомлення друку" topic (printer errors, pauses, finished prints).
# Requires TELEGRAM_ENABLED=true and TELEGRAM_TOPIC_PRINTS_ID set. Off by default.
PRINTER_MONITOR_ENABLED=false
PRINTER_MONITOR_POLL_INTERVAL_MS=15000
# Attach a camera snapshot to printer notifications when one can be fetched.
PRINTER_SNAPSHOT_ENABLED=true
PRINTER_SNAPSHOT_TIMEOUT_MS=4000
PRINTER_SNAPSHOT_MAX_BYTES=3000000
