# Shop watchdog — settings and secrets (compose service `shop-watchdog`).
#
# Copy to apps/shop-watchdog/.env (ignored by git), chmod 600, fill in, then:
#   docker compose up -d --no-deps --force-recreate shop-watchdog
#
# This file is the ONLY source of the watchdog's configuration. It does not read
# apps/api/.env or the root .env: the watchdog holds no credential of the
# fulfillment API, and a change of the API's Telegram settings does not change
# where — or whether — an outage of the shop is reported.
#
# An invalid or missing value is a configuration ERROR, not a default: the
# service stays up, probes nothing, explains why on /status and answers /metrics
# with 503.

# ── Telegram: who writes and where ───────────────────────────────────────────
# Must be exactly "true": a watchdog that cannot notify is not a watchdog.
TELEGRAM_ENABLED=true

# Token of the bot that writes the messages. It must be a member of the chat
# below. A token regenerated in BotFather invalidates the old one at once, so
# when the bot's token is rotated it has to be replaced HERE as well (and the
# service recreated) — every other holder of the old token goes silent.
# The watchdog checks this itself every few minutes (/status → channel).
TELEGRAM_BOT_TOKEN=

# Destination: the chat (a group with topics has an id like -100…) and the topic
# inside it. Set BOTH: a topic id means something only inside its own chat.
# /status shows the topic and that the destination is pinned (chatSource).
SHOP_WATCHDOG_TELEGRAM_CHAT_ID=
SHOP_WATCHDOG_TELEGRAM_THREAD_ID=

# ── What is watched ──────────────────────────────────────────────────────────
# The shop's PUBLIC entry, the one a buyer uses (no trailing slash, no
# credentials). Required: without it the watchdog probes nothing and reports
# itself as not working.
SHOP_WATCHDOG_BASE_URL=

# Shared secret of the heartbeat (dead-man) webhook: the shop's Alertmanager
# POSTs /heartbeat with `Authorization: Bearer <token>`. At least 24 characters;
# generate with `openssl rand -hex 32`. Empty = the dead-man track is off.
SHOP_WATCHDOG_HEARTBEAT_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
# How the service is named in messages, and where the owner should look when one
# arrives (free text, e.g. a runbook path).
#SHOP_WATCHDOG_SERVICE_NAME=
#SHOP_WATCHDOG_RUNBOOK=

# Tuning (defaults shown). An outage is reported after DOWN_AFTER consecutive
# failed cycles and closed after UP_AFTER consecutive good ones; while it stays
# open there is at most one reminder per REMINDER_MS (0 = none).
# EMPTY_CATALOG_AFTER: cycles with an empty catalog before that is reported
# (0 = never). HEARTBEAT_MAX_AGE_MS: silence of the shop's monitoring that is
# reported.
#SHOP_WATCHDOG_INTERVAL_MS=30000
#SHOP_WATCHDOG_TIMEOUT_MS=5000
#SHOP_WATCHDOG_DOWN_AFTER=3
#SHOP_WATCHDOG_UP_AFTER=2
#SHOP_WATCHDOG_EMPTY_CATALOG_AFTER=30
#SHOP_WATCHDOG_REMINDER_MS=3600000
#SHOP_WATCHDOG_HEARTBEAT_MAX_AGE_MS=900000
# How often Telegram is asked — without sending anything — whether the bot may
# still use the chat (a revoked token or a removed bot → /metrics 503). 0 = never.
#SHOP_WATCHDOG_CHANNEL_CHECK_MS=300000
#TELEGRAM_REQUEST_TIMEOUT_MS=10000
