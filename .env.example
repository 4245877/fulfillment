# Root compose environment (copy to .env). Secrets live only in the untracked
# .env — never commit real values.

# Shared secret guarding admin/mutating endpoints (backups, pricing writes,
# notification dispatch, ALL filament warehouse writes). Loaded into the API via
# env_file and baked into the dashboard bundle as VITE_ADMIN_TOKEN (compose
# build arg), so the operator UI keeps working while external/CSRF callers are
# refused. Rotate by changing this value and rebuilding the dashboard image.
ADMIN_TOKEN=

# Inter-service token for apps/atelier → apps/fulfillment (automatic filament
# consume + loaded-reel sync). Sent by atelier as `x-service-token`. Scoped to
# those two routes only — it does NOT grant admin access. Loaded into the API
# via env_file. Generate with `openssl rand -hex 32`; never commit the real
# value. See apps/api/.env.example for the full description.
ATELIER_FULFILLMENT_TOKEN=

# Staged-rollout compatibility: when true, the inter-service routes accept a
# caller without a valid service token and warn. OFF by default; keep it unset
# in production once atelier sends the token.
ATELIER_FULFILLMENT_AUTH_OPTIONAL=false

# Address of the atelier print-dashboard for the link on the read-only
# printers page (e.g. http://<host>:8090/ or a reverse-proxy path). Baked into
# the dashboard bundle at build time (VITE_ATELIER_DASHBOARD_URL). Leave empty
# to hide the link entirely — nothing is hardcoded in the frontend.
ATELIER_DASHBOARD_URL=

# ── Shop watchdog (compose service `shop-watchdog`, apps/shop-watchdog) ──────
# Independent external observer of the Lite Forest shop. Telegram settings are
# taken from apps/api/.env (TELEGRAM_*); everything else is here.

# The shop's PUBLIC entry, the one a buyer uses (no trailing slash, no
# credentials). Required: without it the watchdog probes nothing and reports
# itself as not working.
SHOP_WATCHDOG_BASE_URL=

# Shared secret of the heartbeat (dead-man) webhook: the shop's Alertmanager
# POSTs /heartbeat with `Authorization: Bearer <token>`. At least 24 characters;
# generate with `openssl rand -hex 32`. Empty = the dead-man track is off.
SHOP_WATCHDOG_HEARTBEAT_TOKEN=

# Optional: where the watchdog writes. Empty = the API's own chat and its
# "critical errors" topic (TELEGRAM_CHAT_ID / TELEGRAM_TOPIC_CRITICAL_ERRORS_ID in
# apps/api/.env). Set BOTH to pin the watchdog to a chat and topic of its own,
# independent of what the API uses: a topic id belongs to its chat, so a pinned
# chat never inherits the API's topic. The bot (TELEGRAM_BOT_TOKEN) must be a
# member of that chat. /status shows whose chat is used (chatSource) and the topic.
SHOP_WATCHDOG_TELEGRAM_CHAT_ID=
SHOP_WATCHDOG_TELEGRAM_THREAD_ID=

# Optional. How the service is named in messages, and where the owner should
# look when one arrives (free text, e.g. a runbook path).
SHOP_WATCHDOG_SERVICE_NAME=
SHOP_WATCHDOG_RUNBOOK=

# Optional tuning (defaults shown). An outage is reported after DOWN_AFTER
# consecutive failed cycles and closed after UP_AFTER consecutive good ones;
# while it stays open there is at most one reminder per REMINDER_MS (0 = none).
# EMPTY_CATALOG_AFTER: cycles with an empty catalog before that is reported
# (0 = never). HEARTBEAT_MAX_AGE_MS: silence of the shop's monitoring that is
# reported.
#SHOP_WATCHDOG_INTERVAL_MS=30000
#SHOP_WATCHDOG_TIMEOUT_MS=5000
#SHOP_WATCHDOG_DOWN_AFTER=3
#SHOP_WATCHDOG_UP_AFTER=2
#SHOP_WATCHDOG_EMPTY_CATALOG_AFTER=30
#SHOP_WATCHDOG_REMINDER_MS=3600000
#SHOP_WATCHDOG_HEARTBEAT_MAX_AGE_MS=900000

# uid:gid that owns apps/shop-watchdog/state on this host (default 1000:1000).
#SHOP_WATCHDOG_UID=1000
#SHOP_WATCHDOG_GID=1000
